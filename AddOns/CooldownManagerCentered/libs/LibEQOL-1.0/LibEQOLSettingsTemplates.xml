<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="LibEQOLcooldownmanagercentered_SettingsListSectionHintTemplate" mixin="SettingsListSectionHeaderMixin" virtual="true">
        <Size x="30" y="29"/>
        <Layers>
        <Layer level="OVERLAY">
            <FontString parentKey="Title" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
            <Anchors>
                <Anchor point="TOPLEFT" x="35" y="0"/>
            </Anchors>
            </FontString>
        </Layer>
        </Layers>
        <Frames>
            <Frame parentKey="NewFeature" inherits="NewFeatureLabelTemplate" frameStrata="HIGH" scale=".8" frameLevel="100" hidden="true">
                <Size x="1" y="1"/>
                <Anchors>
                <Anchor point="BOTTOMRIGHT" x="16" y="-10" relativeKey="$parent.Title" relativePoint="LEFT"/>
                </Anchors>
            </Frame>
        </Frames>
        <Scripts>
        <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

    <Frame name="CooldownManagerCentered_SettingsBannerTemplate" inherits="SettingsListElementTemplate" virtual="true">
        <Size x="635" y="318"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture
                    parentKey="Banner"
                    file="Interface\AddOns\CooldownManagerCentered\Media\Preview\in_settings_banner.png"
                    setAllPoints="true"
                />
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                SettingsListElementMixin.OnLoad(self);
                self.Tooltip:Hide();
                self.Tooltip:EnableMouse(false);
            </OnLoad>
        </Scripts>
    </Frame>

     <Button name="LibEQOLcooldownmanagercentered_MultiDropdownTemplate"
        virtual="true"
        inherits="SettingsDropdownControlTemplate"
        mixin="LibEQOLCMC_MultiDropdownMixin">
    </Button>

    <Button name="LibEQOLcooldownmanagercentered_ScrollDropdownTemplate"
        virtual="true"
        inherits="SettingsDropdownControlTemplate"
        mixin="LibEQOLCMC_ScrollDropdownMixin">
    </Button>

    <Frame name="LibEQOLcooldownmanagercentered_CompactFontTemplate"
        virtual="true"
        inherits="SettingsCheckboxDropdownControlTemplate"
        mixin="LibEQOLCMC_CompactFontSettingsMixin">
    </Frame>

    <Frame name="LibEQOLcooldownmanagercentered_CompactSliderMenuTemplate"
        virtual="true"
        mixin="LibEQOLCMC_CompactSliderMenuMixin">
        <Size x="168" y="30"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

    <Frame name="LibEQOLcooldownmanagercentered_InputControlTemplate"
        virtual="true"
        inherits="SettingsListElementTemplate"
        mixin="LibEQOLCMC_InputControlMixin">
        <Size x="280" y="26"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

    <Frame name="LibEQOLcooldownmanagercentered_ColorOverridesPanel" mixin="LibEQOLCMC_ColorOverridesMixin" virtual="true">
		<Size x="200" y="60"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Header" inherits="GameFontNormal" justifyH="LEFT">
					<Size x="0" y="20"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="37" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="List" inherits="VerticalLayoutFrame">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Header" relativePoint="BOTTOMLEFT" x="15" y="-10"/>
				</Anchors>
				<KeyValues>
					<KeyValue key="spacing" value="10" type="number"/>
				</KeyValues>
			</Frame>
			<Frame parentKey="NewFeature" inherits="NewFeatureLabelTemplate" scale="0.8">
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.Header" relativePoint="LEFT" x="16" y="7"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<Frame name="LibEQOLcooldownmanagercentered_ColorOverridesPanelNoHead"
		mixin="LibEQOLCMC_ColorOverridesMixin"
		inherits="SettingsListElementTemplate"
		virtual="true"
	>
	<Size x="200" y="25"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Header" inherits="GameFontNormal" justifyH="LEFT">
					<Size x="0" y="0"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="37" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="List" inherits="VerticalLayoutFrame">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Header" relativePoint="BOTTOMLEFT" x="15" y="0"/>
				</Anchors>
				<KeyValues>
					<KeyValue key="spacing" value="10" type="number"/>
				</KeyValues>
			</Frame>
			<Frame parentKey="NewFeature" inherits="NewFeatureLabelTemplate" scale="0.8">
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.Header" relativePoint="LEFT" x="16" y="7"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<Frame name="LibEQOLcooldownmanagercentered_SoundDropdownTemplate"
		inherits="SettingsListElementTemplate"
		mixin="LibEQOLCMC_SoundDropdownMixin"
		virtual="true"
	>
	<Size x="200" y="25"/>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>

	<Frame name="LibEQOLcooldownmanagercentered_SortableListTemplate"
		inherits="SettingsListElementTemplate"
